{
  "name": "dsh-session-keepwarm",
  "version": "0.1.0",
  "description": "Keeps the most recently used sessions resident in the browser, so switching back reuses the loaded history instead of re-reading it.",
  "type": "module",
  "main": "lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "src/",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "npm run build:client",
    "build:client": "esbuild src/client.js --bundle --minify --format=cjs --platform=browser --charset=utf8 --outfile=lib/client.js --log-level=warning",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "session",
    "history",
    "cache"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dzwalker/dsh-session-keepwarm.git"
  },
  "homepage": "https://github.com/dzwalker/dsh-session-keepwarm#readme",
  "bugs": {
    "url": "https://github.com/dzwalker/dsh-session-keepwarm/issues"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "compatibility": {
      "dshReleases": {
        "0.1.7-rc.2": "compatible"
      }
    }
  }
}
